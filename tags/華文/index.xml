      <description>&lt;div class=&#34;carousel-container&#34;&gt;&#xA;  &lt;div class=&#34;carousel-wrapper&#34;&gt;&#xA;    &lt;div class=&#34;carousel-track&#34;&gt;&#xA;      &lt;img src=&#34;https://www.kiantiong.com/images/taigi-mygo-1.jpg&#34; class=&#34;carousel-img&#34; loading=&#34;lazy&#34; /&gt;&#xA;      &lt;img src=&#34;https://www.kiantiong.com/images/taigi-mygo-2.jpg&#34; class=&#34;carousel-img&#34; loading=&#34;lazy&#34; /&gt;&#xA;      &lt;img src=&#34;https://www.kiantiong.com/images/taigi-mygo-3.jpg&#34; class=&#34;carousel-img&#34; loading=&#34;lazy&#34; /&gt;&#xA;      &lt;img src=&#34;https://www.kiantiong.com/images/taigi-mygo-4.jpg&#34; class=&#34;carousel-img&#34; loading=&#34;lazy&#34; /&gt;&#xA;      &lt;img src=&#34;https://www.kiantiong.com/images/taigi-mygo-5.jpg&#34; class=&#34;carousel-img&#34; loading=&#34;lazy&#34; /&gt;&#xA;      &lt;img src=&#34;https://www.kiantiong.com/images/taigi-mygo-6.jpg&#34; class=&#34;carousel-img&#34; loading=&#34;lazy&#34; /&gt;&#xA;      &lt;img src=&#34;https://www.kiantiong.com/images/taigi-mygo-7.jpg&#34; class=&#34;carousel-img&#34; loading=&#34;lazy&#34; /&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;  &lt;div class=&#34;carousel-controls&#34;&gt;&#xA;    &lt;button class=&#34;carousel-btn prev&#34;&gt;&amp;#8592;&lt;/button&gt;&#xA;    &lt;div class=&#34;carousel-indicator&#34;&gt;&#xA;      &lt;span class=&#34;carousel-current&#34;&gt;1&lt;/span&gt;/&lt;span class=&#34;carousel-total&#34;&#xA;        &gt;7&lt;/span&#xA;      &gt;&#xA;    &lt;/div&gt;&#xA;    &lt;button class=&#34;carousel-btn next&#34;&gt;&amp;#8594;&lt;/button&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&lt;script&gt;&#xA;  (function () {&#xA;    const container = document.currentScript.previousElementSibling;&#xA;    const track = container.querySelector(&#34;.carousel-track&#34;);&#xA;    const images = track.querySelectorAll(&#34;img&#34;);&#xA;    const prevBtn = container.querySelector(&#34;.carousel-btn.prev&#34;);&#xA;    const nextBtn = container.querySelector(&#34;.carousel-btn.next&#34;);&#xA;    const indicator = container.querySelector(&#34;.carousel-indicator&#34;);&#xA;    const current = indicator.querySelector(&#34;.carousel-current&#34;);&#xA;    let idx = 0;&#xA;    function update() {&#xA;      track.style.transform = `translateX(-${idx * 100}%)`;&#xA;      current.textContent = idx + 1;&#xA;    }&#xA;    prevBtn.onclick = function () {&#xA;      idx = (idx - 1 + images.length) % images.length;&#xA;      update();&#xA;    };&#xA;    nextBtn.onclick = function () {&#xA;      idx = (idx + 1) % images.length;&#xA;      update();&#xA;    };&#xA;    &#xA;    let startX = null;&#xA;    track.addEventListener(&#34;touchstart&#34;, (e) =&gt; {&#xA;      startX = e.touches[0].clientX;&#xA;    });&#xA;    track.addEventListener(&#34;touchend&#34;, (e) =&gt; {&#xA;      if (startX === null) return;&#xA;      let dx = e.changedTouches[0].clientX - startX;&#xA;      if (Math.abs(dx) &gt; 50) {&#xA;        if (dx &lt; 0) nextBtn.onclick();&#xA;        else prevBtn.onclick();&#xA;      }&#xA;      startX = null;&#xA;    });&#xA;  })();&#xA;&lt;/script&gt;&#xA;&#xA;&#xA;&#xA;&lt;div class=&#34;mandarin-content&#34; lang=&#34;zh-hant&#34; data-language=&#34;mandarin&#34;&gt;&#xA;    3/10 貼在 &#xA;&lt;a href=&#34;https://www.threads.com/@kiantiong_tan/post/DHAfXy6TFBy&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;Threads &lt;/a&gt; 上的一些台語版本的 MyGO 迷因，模仿公視台語台的雙語字幕格式。&#xA;&lt;/div&gt; &#xA;&#xA;&#xA;&lt;div class=&#34;taiwanese-content&#34; lang=&#34;und-hani&#34; data-language=&#34;taiwanese&#34;&gt;&#xA;    3/10 鋪佇 &#xA;&lt;a href=&#34;https://www.threads.com/@kiantiong_tan/post/DHAfXy6TFBy&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;Threads &lt;/a&gt; 頂面的一寡台語版本的 MyGO Mî-im，模仿公視台語台的雙語字幕格式。&#xA;&lt;/div&gt; &#xA;</description>
    </item>
