&lt;p&gt;Made for Genuary2025-28 &amp;quot;Infinite Scroll.&amp;quot;&lt;/p&gt;
 

&lt;div
 class="sketch-embed-wrapper"
 style="width: 100%; max-width: 700px; margin: 2em auto;"
&gt;
 
 &lt;div
 style="
 display: flex;
 align-items: center;
 gap: 0.75em;
 margin-bottom: 0.75em;
 "
 &gt;
 
 &lt;div style="display: flex; gap: 0.5em; align-items: center"&gt;
 
 &lt;button
 id="sketch-iframe-b04a83d864c01a14e525708fd8333ec7-play-btn"
 onclick="playSketch('sketch-iframe-b04a83d864c01a14e525708fd8333ec7')"
 class="sketch-control-btn sketch-play-btn"
 style="
 width: 40px;
 height: 40px;
 border-radius: 50%;
 border: none;
 background: #5c8273;
 cursor: pointer;
 display: flex;
 align-items: center;
 justify-content: center;
 padding: 0;
 transition: all 0.2s ease;
 margin: 0;
 "
 title="播放"
 &gt;
 &lt;svg
 width="16"
 height="16"
 viewBox="0 0 24 24"
 fill="none"
 stroke="white"
 stroke-width="2"
 stroke-linecap="round"
 stroke-linejoin="round"
 &gt;
 &lt;polygon points="5 3 19 12 5 21 5 3"&gt;&lt;/polygon&gt;
 &lt;/svg&gt;
 &lt;/button&gt;

 
 &lt;button
 id="sketch-iframe-b04a83d864c01a14e525708fd8333ec7-stop-btn"
 onclick="stopSketch('sketch-iframe-b04a83d864c01a14e525708fd8333ec7')"
 class="sketch-control-btn sketch-stop-btn"
 style="
 width: 40px;
 height: 40px;
 border-radius: 50%;
 border: none;
 background: #e0e0e0;
 cursor: pointer;
 display: flex;
 align-items: center;
 justify-content: center;
 padding: 0;
 transition: all 0.2s ease;
 margin: 0;
 "
 title="停止"
 &gt;
 &lt;svg
 width="16"
 height="16"
 viewBox="0 0 24 24"
 fill="none"
 stroke="#666"
 stroke-width="2"
 stroke-linecap="round"
 stroke-linejoin="round"
 &gt;
 &lt;rect x="6" y="6" width="12" height="12"&gt;&lt;/rect&gt;
 &lt;/svg&gt;
 &lt;/button&gt;
 &lt;/div&gt;

 
 &lt;a
 href="https://www.kiantiong.com/sketches/infinite_scroll_genuary2025/?sketch_only=true"
 target="_blank"
 rel="noopener noreferrer"
 style="
 font-size: 0.95em;
 color: #333;
 font-weight: 500;
 text-decoration: none;
 transition: color 0.2s ease;
 "
 onmouseover="this.style.color='var(--link-color, #5c8273)'"
 onmouseout="this.style.color='#333'"
 &gt;3 Colors Transition－Infinite scroll&lt;/a
 &gt;
 &lt;/div&gt;
 

 &lt;div
 class="sketch-embed"
 style="
 width: 100%;
 position: relative;
 border-radius: 8px;
 overflow: hidden;
 box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
 aspect-ratio: 700 / 700;
 "
 &gt;
 &lt;iframe
 id="sketch-iframe-b04a83d864c01a14e525708fd8333ec7"
 src="https://www.kiantiong.com/sketches/infinite_scroll_genuary2025/?sketch_only=true"
 width="100%"
 height="100%"
 frameborder="0"
 scrolling="no"
 style="
 position: absolute;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 border: none;
 "
 loading="lazy"
 title="3 Colors Transition－Infinite scroll - p5.js Sketch"
 &gt;
 &lt;/iframe&gt;
 &lt;/div&gt;
&lt;/div&gt;


&lt;script&gt;
 (function () {
 const iframeId = "sketch-iframe-b04a83d864c01a14e525708fd8333ec7";
 const shouldAutoplay = true;
 let isPlaying = shouldAutoplay;
 const linkColor = "#5c8273";
 const grayBg = "#e0e0e0";
 const grayIcon = "#666";
 const whiteIcon = "#fff";

 function updateButtonStates(id, playing) {
 const playBtn = document.getElementById(id + "-play-btn");
 const stopBtn = document.getElementById(id + "-stop-btn");

 if (playing) {
 
 if (playBtn) {
 playBtn.style.background = linkColor;
 const svg = playBtn.querySelector("svg");
 if (svg) {
 svg.setAttribute("stroke", whiteIcon);
 }
 }
 if (stopBtn) {
 stopBtn.style.background = grayBg;
 const svg = stopBtn.querySelector("svg");
 if (svg) {
 svg.setAttribute("stroke", grayIcon);
 }
 }
 } else {
 
 if (playBtn) {
 playBtn.style.background = grayBg;
 const svg = playBtn.querySelector("svg");
 if (svg) {
 svg.setAttribute("stroke", grayIcon);
 }
 }
 if (stopBtn) {
 stopBtn.style.background = linkColor;
 const svg = stopBtn.querySelector("svg");
 if (svg) {
 svg.setAttribute("stroke", whiteIcon);
 }
 }
 }
 }

 function playSketch(id) {
 const iframe = document.getElementById(id);
 if (iframe) {
 
 iframe.src =
 iframe.src.split("?")[0] + "?sketch_only=true&amp;t=" + Date.now();
 isPlaying = true;
 updateButtonStates(id, true);
 }
 }

 function stopSketch(id) {
 const iframe = document.getElementById(id);
 if (iframe &amp;&amp; isPlaying) {
 
 try {
 iframe.contentWindow.postMessage({ type: "pause-sketch" }, "*");
 isPlaying = false;
 updateButtonStates(id, false);
 } catch (e) {
 
 console.warn("無法發送暫停訊息，嘗試重新載入");
 iframe.src =
 iframe.src.split("?")[0] + "?sketch_only=true&amp;t=" + Date.now();
 }
 }
 }

 
 
 updateButtonStates(iframeId, shouldAutoplay);
 

 
 const iframe = document.getElementById(iframeId);
 if (iframe &amp;&amp; !shouldAutoplay) {
 let paused = false; 

 
 const messageHandler = function(event) {
 
 if (event.source !== iframe.contentWindow) return;

 if (event.data &amp;&amp; event.data.type === 'sketch-loaded' &amp;&amp; !paused) {
 paused = true;
 
 setTimeout(function() {
 try {
 iframe.contentWindow.postMessage({ type: "pause-sketch" }, "*");
 } catch (e) {
 console.warn("無法發送暫停訊息:", e);
 }
 }, 100); 
 }
 };
 window.addEventListener('message', messageHandler);

 
 let fallbackAttempts = 0;
 const maxFallbackAttempts = 30; 
 iframe.addEventListener('load', function() {
 const fallbackPause = function() {
 if (fallbackAttempts &lt; maxFallbackAttempts &amp;&amp; !paused) {
 try {
 iframe.contentWindow.postMessage({ type: "pause-sketch" }, "*");
 } catch (e) {
 
 }
 fallbackAttempts++;
 if (fallbackAttempts &lt; maxFallbackAttempts &amp;&amp; !paused) {
 setTimeout(fallbackPause, 100);
 } else if (fallbackAttempts &gt;= maxFallbackAttempts) {
 paused = true; 
 }
 }
 };
 
 setTimeout(fallbackPause, 1000);
 });
 }

 
 
 window["playSketch_" + iframeId] = function () {
 playSketch(iframeId);
 };
 window["stopSketch_" + iframeId] = function () {
 stopSketch(iframeId);
 };

 
 window["playSketch"] = function (id) {
 playSketch(id);
 };
 window["stopSketch"] = function (id) {
 stopSketch(id);
 };
 
 })();
&lt;/script&gt;
 

