 &lt;button type="button" class="taigi-par-tab" role="tab" data-taigi-mode="hanji" id="taigi-tab-hanji-0" aria-selected="false" aria-controls="taigi-panel-0" tabindex="-1"&gt;漢字標台羅&lt;/button&gt;
 &lt;button type="button" class="taigi-par-tab" role="tab" data-taigi-mode="tailo" id="taigi-tab-tailo-0" aria-selected="false" aria-controls="taigi-panel-0" tabindex="-1"&gt;台羅標漢字&lt;/button&gt;
 &lt;button type="button" class="taigi-par-tab" role="tab" data-taigi-mode="split" id="taigi-tab-split-0" aria-selected="false" aria-controls="taigi-panel-0" tabindex="-1"&gt;並列&lt;/button&gt;
 &lt;/div&gt;
