&lt;p&gt;揤放送鈕就通產生新的結果&lt;/p&gt;
 

&lt;div
 class="sketch-embed-wrapper"
 style="width: 100%; max-width: 500px; margin: 2em auto;"
&gt;
 
 &lt;div
 style="
 display: flex;
 align-items: center;
 gap: 0.75em;
 margin-bottom: 0.75em;
 "
 &gt;
 
 &lt;div style="display: flex; gap: 0.5em; align-items: center"&gt;
 
 &lt;button
 id="sketch-iframe-6bb7bcee2b35f980a4ee601ebc5c8fd7-play-btn"
 onclick="playSketch('sketch-iframe-6bb7bcee2b35f980a4ee601ebc5c8fd7')"
 class="sketch-control-btn sketch-play-btn"
 style="
 width: 40px;
 height: 40px;
 border-radius: 50%;
 border: none;
 background: #5c8273;
 cursor: pointer;
 display: flex;
 align-items: center;
 justify-content: center;
 padding: 0;
 transition: all 0.2s ease;
 margin: 0;
 "
 title="播放"
 &gt;
 &lt;svg
 width="16"
 height="16"
 viewBox="0 0 24 24"
 fill="none"
 stroke="white"
 stroke-width="2"
 stroke-linecap="round"
 stroke-linejoin="round"
 &gt;
 &lt;polygon points="5 3 19 12 5 21 5 3"&gt;&lt;/polygon&gt;
 &lt;/svg&gt;
 &lt;/button&gt;

 
 &lt;button
 id="sketch-iframe-6bb7bcee2b35f980a4ee601ebc5c8fd7-stop-btn"
 onclick="stopSketch('sketch-iframe-6bb7bcee2b35f980a4ee601ebc5c8fd7')"
 class="sketch-control-btn sketch-stop-btn"
 style="
 width: 40px;
 height: 40px;
 border-radius: 50%;
 border: none;
 background: #e0e0e0;
 cursor: pointer;
 display: flex;
 align-items: center;
 justify-content: center;
 padding: 0;
 transition: all 0.2s ease;
 margin: 0;
 "
 title="停止"
 &gt;
 &lt;svg
 width="16"
 height="16"
 viewBox="0 0 24 24"
 fill="none"
 stroke="#666"
 stroke-width="2"
 stroke-linecap="round"
 stroke-linejoin="round"
 &gt;
 &lt;rect x="6" y="6" width="12" height="12"&gt;&lt;/rect&gt;
 &lt;/svg&gt;
 &lt;/button&gt;
 &lt;/div&gt;

 
 &lt;a
 href="https://www.kiantiong.com/sketches/eclipse/?sketch_only=true"
 target="_blank"
 rel="noopener noreferrer"
 style="
 font-size: 0.95em;
 color: #333;
 font-weight: 500;
 text-decoration: none;
 transition: color 0.2s ease;
 "
 onmouseover="this.style.color='var(--link-color, #5c8273)'"
 onmouseout="this.style.color='#333'"
 &gt;Eclipse 蝕&lt;/a
 &gt;
