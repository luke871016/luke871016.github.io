 aspect-ratio: 500 / 700;
 "
 &gt;
 &lt;iframe
 id="sketch-iframe-6bb7bcee2b35f980a4ee601ebc5c8fd7"
 src="https://www.kiantiong.com/sketches/eclipse/?sketch_only=true"
 width="100%"
 height="100%"
 frameborder="0"
 scrolling="no"
 style="
 position: absolute;
 top: 0;
 left: 0;
 width: 100%;
