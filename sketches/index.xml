grayBg;&#xA;          const svg = playBtn.querySelector(&#34;svg&#34;);&#xA;          if (svg) {&#xA;            svg.setAttribute(&#34;stroke&#34;, grayIcon);&#xA;          }&#xA;        }&#xA;        if (stopBtn) {&#xA;          stopBtn.style.background = linkColor;&#xA;          const svg = stopBtn.querySelector(&#34;svg&#34;);&#xA;          if (svg) {&#xA;            svg.setAttribute(&#34;stroke&#34;, whiteIcon);&#xA;          }&#xA;        }&#xA;      }&#xA;    }&#xA;&#xA;    function playSketch(id) {&#xA;      const iframe = document.getElementById(id);&#xA;      if (iframe) {&#xA;        &#xA;        iframe.src =&#xA;          iframe.src.split(&#34;?&#34;)[0] + &#34;?sketch_only=true&amp;t=&#34; + Date.now();&#xA;        isPlaying = true;&#xA;        updateButtonStates(id, true);&#xA;      }&#xA;    }&#xA;&#xA;    function stopSketch(id) {&#xA;      const iframe = document.getElementById(id);&#xA;      if (iframe &amp;&amp; isPlaying) {&#xA;        &#xA;        try {&#xA;          iframe.contentWindow.postMessage({ type: &#34;pause-sketch&#34; }, &#34;*&#34;);&#xA;          isPlaying = false;&#xA;          updateButtonStates(id, false);&#xA;        } catch (e) {&#xA;          &#xA;          console.warn(&#34;無法發送暫停訊息，嘗試重新載入&#34;);&#xA;          iframe.src =&#xA;            iframe.src.split(&#34;?&#34;)[0] + &#34;?sketch_only=true&amp;t=&#34; + Date.now();&#xA;        }&#xA;      }&#xA;    }&#xA;&#xA;    &#xA;    &#xA;    updateButtonStates(iframeId, shouldAutoplay);&#xA;    &#xA;&#xA;    &#xA;    const iframe = document.getElementById(iframeId);&#xA;    if (iframe &amp;&amp; !shouldAutoplay) {&#xA;      let paused = false; &#xA;&#xA;      &#xA;      const messageHandler = function(event) {&#xA;        &#xA;        if (event.source !== iframe.contentWindow) return;&#xA;&#xA;        if (event.data &amp;&amp; event.data.type === &#39;sketch-loaded&#39; &amp;&amp; !paused) {&#xA;          paused = true;&#xA;          &#xA;          setTimeout(function() {&#xA;            try {&#xA;              iframe.contentWindow.postMessage({ type: &#34;pause-sketch&#34; }, &#34;*&#34;);&#xA;            } catch (e) {&#xA;              console.warn(&#34;無法發送暫停訊息:&#34;, e);&#xA;            }&#xA;          }, 100); &#xA;        }&#xA;      };&#xA;      window.addEventListener(&#39;message&#39;, messageHandler);&#xA;&#xA;      &#xA;      let fallbackAttempts = 0;&#xA;      const maxFallbackAttempts = 30; &#xA;      iframe.addEventListener(&#39;load&#39;, function() {&#xA;        const fallbackPause = function() {&#xA;          if (fallbackAttempts &lt; maxFallbackAttempts &amp;&amp; !paused) {&#xA;            try {&#xA;              iframe.contentWindow.postMessage({ type: &#34;pause-sketch&#34; }, &#34;*&#34;);&#xA;            } catch (e) {&#xA;              &#xA;            }&#xA;            fallbackAttempts++;&#xA;            if (fallbackAttempts &lt; maxFallbackAttempts &amp;&amp; !paused) {&#xA;              setTimeout(fallbackPause, 100);&#xA;            } else if (fallbackAttempts &gt;= maxFallbackAttempts) {&#xA;              paused = true; &#xA;            }&#xA;          }&#xA;        };&#xA;        &#xA;        setTimeout(fallbackPause, 1000);&#xA;      });&#xA;    }&#xA;&#xA;    &#xA;    &#xA;    window[&#34;playSketch_&#34; + iframeId] = function () {&#xA;      playSketch(iframeId);&#xA;    };&#xA;    window[&#34;stopSketch_&#34; + iframeId] = function () {&#xA;      stopSketch(iframeId);&#xA;    };&#xA;&#xA;    &#xA;    window[&#34;playSketch&#34;] = function (id) {&#xA;      playSketch(id);&#xA;    };&#xA;    window[&#34;stopSketch&#34;] = function (id) {&#xA;      stopSketch(id);&#xA;    };&#xA;    &#xA;  })();&#xA;&lt;/script&gt;&#xA; &#xA;&#xA;
