   style=&#34;&#xA;          width: 40px;&#xA;          height: 40px;&#xA;          border-radius: 50%;&#xA;          border: none;&#xA;          background: #e0e0e0;&#xA;          cursor: pointer;&#xA;          display: flex;&#xA;          align-items: center;&#xA;          justify-content: center;&#xA;          padding: 0;&#xA;          transition: all 0.2s ease;&#xA;          margin: 0;&#xA;        &#34;&#xA;        title=&#34;停止&#34;&#xA;      &gt;&#xA;        &lt;svg&#xA;          width=&#34;16&#34;&#xA;          height=&#34;16&#34;&#xA;          viewBox=&#34;0 0 24 24&#34;&#xA;          fill=&#34;none&#34;&#xA;          stroke=&#34;#666&#34;&#xA;          stroke-width=&#34;2&#34;&#xA;          stroke-linecap=&#34;round&#34;&#xA;          stroke-linejoin=&#34;round&#34;&#xA;        &gt;&#xA;          &lt;rect x=&#34;6&#34; y=&#34;6&#34; width=&#34;12&#34; height=&#34;12&#34;&gt;&lt;/rect&gt;&#xA;        &lt;/svg&gt;&#xA;      &lt;/button&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &#xA;    &lt;a&#xA;      href=&#34;https://www.kiantiong.com/sketches/eclipse/?sketch_only=true&#34;&#xA;      target=&#34;_blank&#34;&#xA;      rel=&#34;noopener noreferrer&#34;&#xA;      style=&#34;&#xA;        font-size: 0.95em;&#xA;        color: #333;&#xA;        font-weight: 500;&#xA;        text-decoration: none;&#xA;        transition: color 0.2s ease;&#xA;      &#34;&#xA;      onmouseover=&#34;this.style.color=&#39;var(--link-color, #5c8273)&#39;&#34;&#xA;      onmouseout=&#34;this.style.color=&#39;#333&#39;&#34;&#xA;      &gt;Eclipse 蝕&lt;/a&#xA;    &gt;&#xA;  &lt;/div&gt;&#xA;  &#xA;&#xA;  &lt;div&#xA;    class=&#34;sketch-embed&#34;&#xA;    style=&#34;&#xA;                width: 100%;&#xA;                position: relative;&#xA;                border-radius: 8px;&#xA;                overflow: hidden;&#xA;                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);&#xA;                aspect-ratio: 500 / 700;&#xA;            &#34;&#xA;  &gt;&#xA;    &lt;iframe&#xA;      id=&#34;sketch-iframe-6bb7bcee2b35f980a4ee601ebc5c8fd7&#34;&#xA;      src=&#34;https://www.kiantiong.com/sketches/eclipse/?sketch_only=true&#34;&#xA;      width=&#34;100%&#34;&#xA;      height=&#34;100%&#34;&#xA;      frameborder=&#34;0&#34;&#xA;      scrolling=&#34;no&#34;&#xA;      style=&#34;&#xA;        position: absolute;&#xA;        top: 0;&#xA;        left: 0;&#xA;        width: 100%;&#xA;        height: 100%;&#xA;        border: none;&#xA;      &#34;&#xA;      loading=&#34;lazy&#34;&#xA;      title=&#34;Eclipse 蝕 - p5.js Sketch&#34;&#xA;    &gt;&#xA;    &lt;/iframe&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&#xA;&lt;script&gt;&#xA;  (function () {&#xA;    const iframeId = &#34;sketch-iframe-6bb7bcee2b35f980a4ee601ebc5c8fd7&#34;;&#xA;    const shouldAutoplay = true;&#xA;    let isPlaying = shouldAutoplay;&#xA;    const linkColor = &#34;#5c8273&#34;;&#xA;    const grayBg = &#34;#e0e0e0&#34;;&#xA;    const grayIcon = &#34;#666&#34;;&#xA;    const whiteIcon = &#34;#fff&#34;;&#xA;&#xA;    function updateButtonStates(id, playing) {&#xA;      const playBtn = document.getElementById(id + &#34;-play-btn&#34;);&#xA;      const stopBtn = document.getElementById(id + &#34;-stop-btn&#34;);&#xA;&#xA;      if (playing) {&#xA;        &#xA;        if (playBtn) {&#xA;          playBtn.style.background = linkColor;&#xA;          const svg = playBtn.querySelector(&#34;svg&#34;);&#xA;          if (svg) {&#xA;            svg.setAttribute(&#34;stroke&#34;, whiteIcon);&#xA;          }&#xA;        }&#xA;        if (stopBtn) {&#xA;          stopBtn.style.background = grayBg;&#xA;          const svg = stopBtn.querySelector(&#34;svg&#34;);&#xA;          if (svg) {&#xA;            svg.setAttribute(&#34;stroke&#34;, grayIcon);&#xA;          }&#xA;        }&#xA;      } else {&#xA;        &#xA;        if (playBtn) {&#xA;          playBtn.style.background = grayBg;&#xA;          const svg = playBtn.querySelector(&#34;svg&#34;);&#xA;          if (svg) {&#xA;            svg.setAttribute(&#34;stroke&#34;, grayIcon);&#xA;          }&#xA;        }&#xA;        if (stopBtn) {&#xA;          stopBtn.style.background = linkColor;&#xA;          const svg = stopBtn.querySelector(&#34;svg&#34;);&#xA;          if (svg) {&#xA;            svg.setAttribute(&#34;stroke&#34;, whiteIcon);&#xA;          }&#xA;        }&#xA;      }&#xA;    }&#xA;&#xA;    function playSketch(id) {&#xA;      const iframe = document.getElementById(id);&#xA;      if (iframe) {&#xA;        &#xA;        iframe.src =&#xA;          iframe.src.split(&#34;?&#34;)[0] + &#34;?sketch_only=true&amp;t=&#34; + Date.now();&#xA;        isPlaying = true;&#xA;        updateButtonStates(id, true);&#xA;      }&#xA;    }&#xA;&#xA;    function stopSketch(id) {&#xA;      const iframe = document.getElementById(id);&#xA;      if (iframe &amp;&amp; isPlaying) {&#xA;        &#xA;        try {&#xA;          iframe.contentWindow.postMessage({ type: &#34;pause-sketch&#34; }, &#34;*&#34;);&#xA;          isPlaying = false;&#xA;          updateButtonStates(id, false);&#xA;        } catch (e) {&#xA;          &#xA;          console.warn(&#34;無法發送暫停訊息，嘗試重新載入&#34;);&#xA;          iframe.src =&#xA;            iframe.src.split(&#34;?&#34;)[0] + &#34;?sketch_only=true&amp;t=&#34; + Date.now();&#xA;        }&#xA;      }&#xA;    }&#xA;&#xA;    &#xA;    &#xA;    updateButtonStates(iframeId, shouldAutoplay);&#xA;    &#xA;&#xA;    &#xA;    const iframe = document.getElementById(iframeId);&#xA;    if (iframe &amp;&amp; !shouldAutoplay) {&#xA;      let paused = false; &#xA;&#xA;      &#xA;      const messageHandler = function(event) {&#xA;        &#xA;        if (event.source !== iframe.contentWindow) return;&#xA;&#xA;        if (event.data &amp;&amp; event.data.type === &#39;sketch-loaded&#39; &amp;&amp; !paused) {&#xA;          paused = true;&#xA;          &#xA;          setTimeout(function() {&#xA;            try {&#xA;              iframe.contentWindow.postMessage({ type: &#34;pause-sketch&#34; }, &#34;*&#34;);&#xA;            } catch (e) {&#xA;              console.warn(&#34;無法發送暫停訊息:&#34;, e);&#xA;            }&#xA;          }, 100); &#xA;        }&#xA;      };&#xA;      window.addEventListener(&#39;message&#39;, messageHandler);&#xA;&#xA;      &#xA;      let fallbackAttempts = 0;&#xA;      const maxFallbackAttempts = 30; &#xA;      iframe.addEventListener(&#39;load&#39;, function() {&#xA;        const fallbackPause = function() {&#xA;          if (fallbackAttempts &lt; maxFallbackAttempts &amp;&amp; !paused) {&#xA;            try {&#xA;              iframe.contentWindow.postMessage({ type: &#34;pause-sketch&#34; }, &#34;*&#34;);&#xA;            } catch (e) {&#xA;              &#xA;            }&#xA;            fallbackAttempts++;&#xA;            if (fallbackAttempts &lt; maxFallbackAttempts &amp;&amp; !paused) {&#xA;              setTimeout(fallbackPause, 100);&#xA;            } else if (fallbackAttempts &gt;= maxFallbackAttempts) {&#xA;              paused = true; &#xA;            }&#xA;          }&#xA;        };&#xA;        &#xA;        setTimeout(fallbackPause, 1000);&#xA;      });&#xA;    }&#xA;&#xA;    &#xA;    &#xA;    window[&#34;playSketch_&#34; + iframeId] = function () {&#xA;      playSketch(iframeId);&#xA;    };&#xA;    window[&#34;stopSketch_&#34; + iframeId] = function () {&#xA;      stopSketch(iframeId);&#xA;    };&#xA;&#xA;    &#xA;    window[&#34;playSketch&#34;] = function (id) {&#xA;      playSketch(id);&#xA;    };&#xA;    window[&#34;stopSketch&#34;] = function (id) {&#xA;      stopSketch(id);&#xA;    };&#xA;    &#xA;  })();&#xA;&lt;/script&gt;&#xA; &#xA;&#xA;&lt;p&gt;這个作品是佇 2024-04-14 參與 #WCCChallenge 所創作，原底發表佇 OpenProcessing 平台（&#xA;&lt;a href=&#34;https://openprocessing.org/sketch/2239516&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;原始連結 &lt;/a&gt;），後來嘛成做我佇平台頂面上衝的作品，我感覺免 100 逝程式就通寫出按呢的成果誠媠，原底就是一个利用 &lt;code&gt;noise&lt;/code&gt; 創作的教材爾，順紲參與社群活動。黃新先生佇政大的學生嘛捌寫過&#xA;&lt;a href=&#34;https://matters.town/a/aq3cu4yzg1ll&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;文章 &lt;/a&gt;欣賞這个作品，感謝逐家的呵咾。&lt;/p&gt;&#xA;&lt;h2 id=&#34;有關-wccchallenge&#34;&gt;有關 #WCCChallenge&lt;/h2&gt;&#xA;&lt;p&gt;WCCChallenge 是一个由德國人&#xA;&lt;a href=&#34;https://linktr.ee/sableraph&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;Raphaël &lt;/a&gt;所發起的程式創作社群活動，逐禮拜會佇 &#xA;&lt;a href=&#34;https://discord.com/invite/S8c7qcjw2b&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;Discord &lt;/a&gt; 投票決定題目，Raphaël 會佇禮拜暗時開&#xA;&lt;a href=&#34;https://www.twitch.tv/sableraph&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;直播 &lt;/a&gt;回顧逐家的投稿，無論是啥物程度的人攏通參加。&lt;/p&gt;&#xA;
